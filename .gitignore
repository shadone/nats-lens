# Build output
/bin/

# Local dev cluster data and the collector's database
/.dev/
/data/
*.duckdb
*.duckdb.wal

# Editors and OS
.DS_Store
.idea/
.vscode/

# Web dependencies
/web/node_modules/

# Web UI build output, embedded by internal/webui
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Local production-build verification state and staging (outside embedded dist)
/internal/webui/.build-*

# Verification helper bytecode
/scripts/__pycache__/

# Release archives (scripts/release-archive.sh)
/dist/

# Performance measurements (scripts/perf.sh)
/.perf/
